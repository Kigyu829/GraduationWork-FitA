<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/cbg"
    >
    <TextView
    android:id="@+id/tvWelcomeMessage"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="대시보드"
    android:textColor="@color/white"
    android:textSize="22sp"
    android:textStyle="bold"
    android:layout_marginBottom="24dp"
    android:layout_marginTop="16dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/dark_gray">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="나의 감량 목표 현황"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:layout_marginBottom="16dp"/>

            <ProgressBar
                android:id="@+id/progressBarWeight"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0"
                android:scaleY="2"
                android:layout_marginBottom="8dp"/>
            <TextView
                android:id="@+id/tvProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="데이터를 불러오는 중입니다..."
                android:textAlignment="center"
                android:textColor="@color/white"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        android:backgroundTint="@color/dark_gray">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오늘의 할 일"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:layout_marginBottom="16dp"/>

            <CheckBox
                android:id="@+id/cbMeal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI 권장 식단 먹기 (0/3)"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/cbWorkout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="오늘의 권장 운동 완료하기"
                android:textColor="@color/white"
                android:textSize="16sp"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="로그아웃"
                android:backgroundTint="@color/candy_red"
                android:layout_marginTop="24dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>