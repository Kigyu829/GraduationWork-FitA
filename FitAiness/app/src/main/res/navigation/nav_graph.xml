<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.capstone.fitainess.SplashFragment">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.capstone.fitainess.LoginFragment">
        <action
            android:id="@+id/action_login_to_signup"
            app:destination="@id/signUpFragment" />
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment android:id="@+id/signUpFragment" android:name="com.capstone.fitainess.SignUpFragment">
        <action android:id="@+id/action_signup_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/signUpFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment android:id="@+id/homeFragment" android:name="com.capstone.fitainess.HomeFragment">
        <action android:id="@+id/action_home_to_bodyInfo"
            app:destination="@id/bodyInfoFragment" />
        <action android:id="@+id/action_home_to_profile"
            app:destination="@id/profileFragment" />
        <action android:id="@+id/action_home_to_target"
            app:destination="@id/targetFragment" />
        <action android:id="@+id/action_home_to_diner"
            app:destination="@id/dinerFragment" />
        <!-- AI 기능 화면으로 이동 -->
        <action android:id="@+id/action_home_to_meal"
            app:destination="@id/mealFragment" />
        <action android:id="@+id/action_home_to_workout"
            app:destination="@id/workoutFragment" />
        <action android:id="@+id/action_home_to_chat"
            app:destination="@id/chatFragment" />
        <action
            android:id="@+id/action_home_to_calendar"
            app:destination="@id/calendarFragment" />

    </fragment>

    <fragment
        android:id="@+id/dinerFragment" android:name="com.capstone.fitainess.DinerFragment" />
        <action android:id="@+id/action_diner_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/dinerFragment"/>

    <fragment android:id="@+id/bodyInfoFragment" android:name="com.capstone.fitainess.BodyInfoFragment">
        <action android:id="@+id/action_bodyInfo_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/bodyInfoFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment android:id="@+id/profileFragment" android:name="com.capstone.fitainess.ProfileFragment">
        <action android:id="@+id/action_profile_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/profileFragment"
            app:popUpToInclusive="true" />
        <action android:id="@+id/action_home_to_target" app:destination="@id/targetFragment" />
        <action android:id="@+id/action_profile_to_bodyInfo"
            app:destination="@id/bodyInfoFragment" />
        <action android:id="@+id/action_profile_to_login"
            app:destination="@id/loginFragment"
            app:popUpToInclusive="true"/>
        <action android:id="@+id/action_profile_to_target"
            app:destination="@id/targetFragment" />
        <action android:id="@+id/profile_to_chat"
            app:destination="@id/chatFragment" />
    </fragment>

    <fragment
        android:id="@+id/targetFragment" android:name="com.capstone.fitainess.TargetFragment"/>
    <action android:id="@+id/action_target_to_home"
        app:destination="@id/homeFragment"
        app:popUpTo="@id/targetFragment"/>
    <action android:id="@+id/action_target_to_profile"
        app:destination="@id/profileFragment"
        app:popUpTo="@id/targetFragment"/>

    <fragment
        android:id="@+id/calendarFragment"
        android:name="com.capstone.fitainess.CalendarFragment" />

    <!-- AI 기능 Fragment들 (뒤로가기로 홈으로 돌아옴) -->
    <fragment
        android:id="@+id/mealFragment"
        android:name="com.capstone.fitainess.MealFragment" />

    <fragment
        android:id="@+id/workoutFragment"
        android:name="com.capstone.fitainess.WorkoutFragment" />

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.capstone.fitainess.ChatFragment" />
    <action android:id="@+id/action_chat_to_home"
        app:destination="@id/homeFragment" />
    <action android:id="@+id/action_chat_to_profile"
        app:destination="@id/profileFragment" />

</navigation>
