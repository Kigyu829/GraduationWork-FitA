<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#1E1E1E">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍽️ AI 식단 추천"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CNN에 학습된 150종 음식 내에서 AI가 식단 추천"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- 입력 영역 (FitAiNess에서는 Firebase 자동 로딩이므로 항상 GONE) -->
    <LinearLayout
        android:id="@+id/inputSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <RadioGroup
            android:id="@+id/rgGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <RadioButton
                android:id="@+id/rbMale"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="남성"
                android:textColor="#FFFFFF"
                android:buttonTint="#66D0BC"
                android:checked="true" />
            <RadioButton
                android:id="@+id/rbFemale"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="여성"
                android:textColor="#FFFFFF"
                android:buttonTint="#66D0BC" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <EditText android:id="@+id/etHeight"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:hint="키(cm)" android:inputType="number"
                android:textColor="#FFFFFF" android:textColorHint="#666666"
                android:background="#2A2A2A" android:padding="10dp" android:textSize="14sp"
                android:layout_marginEnd="8dp" />
            <EditText android:id="@+id/etWeight"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:hint="체중(kg)" android:inputType="number"
                android:textColor="#FFFFFF" android:textColorHint="#666666"
                android:background="#2A2A2A" android:padding="10dp" android:textSize="14sp"
                android:layout_marginEnd="8dp" />
            <EditText android:id="@+id/etTargetWeight"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:hint="목표(kg)" android:inputType="number"
                android:textColor="#FFFFFF" android:textColorHint="#666666"
                android:background="#2A2A2A" android:padding="10dp" android:textSize="14sp" />
        </LinearLayout>

        <Spinner
            android:id="@+id/spTargetWeeks"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="5dp"
            android:background="#2A2A2A"
            android:spinnerMode="dropdown"
            android:theme="@style/ThemeOverlay.AppCompat.Dark" />

        <Button android:id="@+id/btnGenerate"
            android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="🍽️ AI 식단 추천받기"
            android:textSize="16sp" android:textStyle="bold"
            android:textColor="#121212" android:backgroundTint="#66D0BC" />
    </LinearLayout>

    <!-- 재조정 영역 (FitAiNess에서는 AI 상담을 통해서만 재조정, 항상 GONE) -->
    <LinearLayout
        android:id="@+id/adjustSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#1E1E1E"
        android:visibility="gone">

        <EditText
            android:id="@+id/etAdjustReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:hint="재조정 이유"
            android:inputType="textMultiLine"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:background="#2A2A2A"
            android:padding="10dp"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <Spinner
            android:id="@+id/spAdjustWeeks"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#2A2A2A"
            android:spinnerMode="dropdown"
            android:theme="@style/ThemeOverlay.AppCompat.Dark"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnAdjustCancel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="취소"
                android:textColor="#AAAAAA"
                android:backgroundTint="#2A2A2A"
                android:layout_marginEnd="8dp" />
            <Button
                android:id="@+id/btnAdjustConfirm"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="2"
                android:text="AI에게 재조정 요청"
                android:textColor="#121212"
                android:backgroundTint="#66D0BC" />
        </LinearLayout>
    </LinearLayout>

    <!-- 재조정 버튼 (FitAiNess에서는 GONE - AI 상담으로 이동) -->
    <Button android:id="@+id/btnReset"
        android:layout_width="match_parent" android:layout_height="44dp"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:text="🔄 플랜 재조정하기"
        android:textSize="14sp"
        android:textColor="#66D0BC"
        android:backgroundTint="#1A66D0BC"
        android:visibility="gone" />

    <ProgressBar android:id="@+id/progressBar"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:layout_marginTop="12dp"
        android:visibility="gone" android:indeterminateTint="#66D0BC" />

    <!-- 에러 메시지 -->
    <TextView android:id="@+id/tvError"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp" android:textColor="#FF5555" android:textSize="13sp"
        android:visibility="gone" />

    <!-- 카드 결과 영역 -->
    <ScrollView android:id="@+id/scrollResult"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:padding="16dp">

        <LinearLayout android:id="@+id/resultContainer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
