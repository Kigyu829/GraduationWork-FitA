# ─────────────────────────────────────────────
# Ai_server 환경변수 설정 예시
# 이 파일을 복사해서 .env 로 저장 후 값을 입력하세요
# cp .env.example .env
# ─────────────────────────────────────────────

# Gemini API 키 (여러 개는 쉼표로 구분 → 429 초과 시 자동 교체)
# https://aistudio.google.com 에서 무료 발급
GEMINI_API_KEY=your_gemini_api_key_here

# 사용할 Gemini 모델 (기본값: gemini-2.5-flash)
GEMINI_CHAT_MODEL=gemini-2.5-flash

# CNN 서버 주소 (Server/ 폴더, 포트 4000)
CNN_SERVER_URL=http://localhost:4000

# AI 서버 포트 (기본값: 5000)
PORT=5000
