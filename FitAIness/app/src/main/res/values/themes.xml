<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FitAIness" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="colorOnSurface">#FFFFFFFF</item>
    </style>

    <style name="Theme.FitAIness" parent="Base.Theme.FitAIness" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.FitAIness</item>
    </style>

    <style name="CustomEditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:backgroundTint">#FFFFFFFF</item>
        <item name="android:textColorHint">#FFFFFFFF</item>
        <item name="android:colorActivatedHighlight">@color/gasoline_green</item>
    </style>

    <style name="AppTheme.Picker" parent="Theme.AppCompat.Light.NoActionBar" >
        <item name="android:textColorPrimary">@android:color/white</item>
    </style>
</resources>