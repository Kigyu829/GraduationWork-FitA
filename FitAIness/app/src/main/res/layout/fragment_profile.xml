<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center"
    android:background="@color/black">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="내 프로필"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginBottom="48dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F1F3F5"
        android:padding="24dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@color/dark_gray">

        <TextView
            android:id="@+id/tvProfileHeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="키: 불러오는 중..."
            android:textSize="18sp"
            android:textColor="@color/white"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvProfileWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="몸무게: 불러오는 중..."
            android:textSize="18sp"
            android:textColor="@color/white"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvProfileBmi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BMI: 불러오는 중..."
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/gasoline_green"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnGoToEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="신체 정보 수정하기"
        android:padding="12dp"
        android:textColor="@color/white"
        android:textSize="16sp"/>

</LinearLayout>