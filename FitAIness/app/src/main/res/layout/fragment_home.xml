<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/background_gray">
        <TextView
            android:id="@+id/tvWelcomeMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="대시보드"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="16dp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cvChallenge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#243840"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="나의 기록"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvStreakCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0일째 연속 성공 중!"
                        android:textColor="#66D0BC"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:srcCompat="@drawable/ic_calendar"
                    app:tint="#FFFFFF"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cvGoalStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:backgroundTint="@color/dark_gray"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvGoalTitle"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="나의 감량 목표"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvGoalMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="데이터를 불러오는 중..."
                    android:textColor="@color/white"
                    android:textSize="16sp"/>

                <LinearLayout
                    android:id="@+id/layoutWeightUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:visibility="gone">
                    <TextView
                    android:id="@+id/tvCurrentWeightDisplay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="현재 -- kg"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnQuickUpdateWeight"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="기록"
                        android:textColor="#66D0BC"
                        app:strokeColor="#66D0BC" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSetGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="목표 설정하러 가기"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#243840"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오늘의 목표"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="16dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#344955"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvMealTimeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="식단 정보를 불러오는 중..."
                            android:textStyle="bold"
                            android:textColor="#66D0BC"
                            android:layout_marginBottom="8dp"
                            android:gravity="center_vertical"
                            android:drawablePadding="8dp" />

                        <TextView
                            android:id="@+id/tvTodayMealContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="플랜이 없습니다."
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:layout_marginBottom="15dp"/>

                        <Button
                            android:id="@+id/btnGoDiner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="식단 인증"
                            android:textColor="@color/white"
                            android:backgroundTint="@color/gasoline_green"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#344955">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="일일 운동"
                            android:textStyle="bold"
                            android:textColor="@color/white"/>

                        <CheckBox
                            android:id="@+id/cbWorkout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/white"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- AI 기능 카드 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:backgroundTint="#1FFF0B55"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🤖 AI 건강 관리"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginBottom="16dp"/>

                <!-- AI 식단 추천 버튼 -->
                <Button
                    android:id="@+id/btnGoMeal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🍽️  AI 식단 추천 보기"
                    android:textColor="@color/white"
                    android:backgroundTint="#1FFF0B55"
                    android:layout_marginBottom="8dp"/>

                <!-- AI 운동 추천 버튼 -->
                <Button
                    android:id="@+id/btnGoWorkout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💪  AI 운동 추천 보기"
                    android:textColor="@color/white"
                    android:backgroundTint="#1FFF0B55"
                    android:layout_marginBottom="8dp"/>

                <!-- AI 상담 버튼 -->
                <Button
                    android:id="@+id/btnGoChat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💬  AI 건강 상담"
                    android:textColor="@color/white"
                    android:backgroundTint="#1FFF0B55"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>






    </LinearLayout>
</androidx.core.widget.NestedScrollView>