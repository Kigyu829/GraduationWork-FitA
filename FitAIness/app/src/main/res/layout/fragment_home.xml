<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/background_gray">
        <TextView
            android:id="@+id/tvWelcomeMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="대시보드"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/dark_gray">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="나의 감량 목표 현황"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:layout_marginBottom="16dp"/>

                <ProgressBar
                    android:id="@+id/progressBarWeight"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0"
                    android:scaleY="2"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/tvProgressText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="데이터를 불러오는 중..."
                    android:textAlignment="center"
                    android:textColor="@color/white"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cvGoalStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:backgroundTint="@color/dark_gray"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvGoalTitle"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="나의 감량 목표"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvGoalMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="데이터를 불러오는 중..."
                    android:textColor="@color/white"
                    android:textSize="16sp"/>
                <!-- 설정 버튼 (목표 없을 때만 보임) -->
                <Button
                    android:id="@+id/btnSetGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="목표 설정하러 가기"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cvDiner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:backgroundTint="@color/dark_gray"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="오늘의 식단"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp"/>

            <!-- 플랜 없을 때 안내 문구 -->
            <TextView
                android:id="@+id/tvMealNoPlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI 식단 추천을 먼저 받아주세요."
                android:textColor="#888888"
                android:textSize="13sp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"/>

            <!-- 아침/점심/저녁 행이 동적으로 추가되는 컨테이너 -->
            <LinearLayout
                android:id="@+id/mealContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp"/>

            <!-- 합계 칼로리 -->
            <TextView
                android:id="@+id/tvMealTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/gasoline_green"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btnGoDiner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="식단 인증"
                android:textColor="@color/white"
                android:backgroundTint="@color/gasoline_green"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

        <!-- AI 기능 카드 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:backgroundTint="@color/dark_gray"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🤖 AI 건강 관리"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginBottom="16dp"/>

                <!-- AI 식단 추천 버튼 -->
                <Button
                    android:id="@+id/btnGoMeal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🍽️  AI 식단 추천 보기"
                    android:textColor="@color/white"
                    android:backgroundTint="#1A66D0BC"
                    android:layout_marginBottom="8dp"/>

                <!-- AI 운동 추천 버튼 -->
                <Button
                    android:id="@+id/btnGoWorkout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💪  AI 운동 추천 보기"
                    android:textColor="@color/white"
                    android:backgroundTint="#1A66D0BC"
                    android:layout_marginBottom="8dp"/>

                <!-- AI 상담 버튼 -->
                <Button
                    android:id="@+id/btnGoChat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💬  AI 건강 상담"
                    android:textColor="@color/white"
                    android:backgroundTint="#1A66D0BC"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>






    </LinearLayout>
</androidx.core.widget.NestedScrollView>