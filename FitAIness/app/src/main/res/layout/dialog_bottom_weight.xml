<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#243840">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="오늘의 체중 기록"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <Button
            android:id="@+id/btnMinusWeight"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="-"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#344955"
            app:cornerRadius="30dp" /> <TextView
        android:id="@+id/tvWeightPickerValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="65.0"
        android:textColor="#66D0BC"
        android:textSize="36sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="kg"
            android:textColor="#888888"
            android:textSize="18sp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnPlusWeight"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="+"
            android:textSize="24sp"
            android:textColor="#243840"
            android:backgroundTint="#66D0BC"
            app:cornerRadius="30dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSaveWeight"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="저장하기"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#243840"
        android:backgroundTint="#66D0BC"/>

</LinearLayout>